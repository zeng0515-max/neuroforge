# NeuroForge Environment Configuration
# Copy this file to .env and fill in your values

# ============================================================================
# Application
# ============================================================================
APP_NAME=NeuroForge
APP_VERSION=3.0.0
APP_ENV=dev
APP_DEBUG=true
APP_LOG_LEVEL=INFO
APP_HOST=0.0.0.0
APP_PORT=8000

# ============================================================================
# LLM Configuration (OpenAI-compatible API)
# ============================================================================
# Primary model (used for supervisor, requirement analysis, review)
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=sk-your-key-here
LLM_MODEL=gpt-4o
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=4096

# Code-specific model (falls back to primary if not set)
# CODE_LLM_BASE_URL=
# CODE_LLM_API_KEY=
# CODE_LLM_MODEL=
CODE_LLM_TEMPERATURE=0.2
CODE_LLM_MAX_TOKENS=8192

# Provider-specific keys (used automatically when switching models)
DASHSCOPE_API_KEY=
DEEPSEEK_API_KEY=
ARK_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# ============================================================================
# Sandbox Execution
# ============================================================================
# local: Run code in subprocess (fast, less isolation)
# docker: Run code in Docker container (production-safe, requires Docker)
SANDBOX_MODE=local
SANDBOX_IMAGE=python:3.11-slim
SANDBOX_TIMEOUT=30
SANDBOX_MAX_MEMORY_MB=512
SANDBOX_NETWORK=false

# ============================================================================
# Database
# ============================================================================
DB_PATH=data/app.db
DB_ECHO=false

# ============================================================================
# ChromaDB Vector Store
# ============================================================================
CHROMA_PERSIST_DIR=data/chroma
CHROMA_COLLECTION_NAME=code_knowledge
EMBEDDING_MODEL=bge-m3
EMBEDDING_DIM=1024

# ============================================================================
# Security
# ============================================================================
# API key for endpoint protection (leave empty to disable)
# API_KEY=
# Admin key for the kill switch endpoints (GET /api/v1/policy/state,
# POST /api/v1/policy/kill-switch). Leave empty to disable administration:
# the endpoints then fail closed with 503.
# ADMIN_API_KEY=
# Where the kill switch state is persisted (relative paths resolve from the repo root).
# POLICY_STATE_PATH=data/runtime_policy_state.json
AST_ALLOWED_MODULES=math,re,json,typing,collections,itertools,functools,datetime,hashlib,base64,uuid,string,decimal,fractions,statistics,operator,heapq,bisect,array,enum,dataclasses,abc,io,os,sys,threading,csv,queue,pathlib,pytest,unittest,time,logging,argparse,pprint,copy,random,numpy,pandas,requests,app.*,tools.*,agents.*,graph.*,schemas.*,core.*,services.*,src.*

# ============================================================================
# Agent Configuration
# ============================================================================
AGENT_MAX_RETRIES=3
AGENT_SKILL_DIR=app/skills

# ============================================================================
# Tracing (OpenTelemetry)
# ============================================================================
TRACING_ENABLED=false
TRACING_SERVICE_NAME=neuroforge
# TRACING_OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

# ============================================================================
# Memory System
# ============================================================================
MEMORY_ENABLED=true
MEMORY_COLLECTION=agent_memory

# ============================================================================
# Semantic Cache
# ============================================================================
SEMANTIC_CACHE_ENABLED=true
SEMANTIC_CACHE_SIMILARITY_THRESHOLD=0.95
SEMANTIC_CACHE_MAX_ENTRIES=10000

# ============================================================================
# Rate Limiting
# ============================================================================
RATE_LIMIT_ENABLED=false
RATE_LIMIT_REQUESTS_PER_MINUTE=60

# ============================================================================
# Guardrails (Prompt injection protection)
# ============================================================================
GUARDRAIL_ENABLED=false

# ============================================================================
# Model Routing
# ============================================================================
# Format: task_type:model_role (code_gen:code means code generation uses code model)
MODEL_ROUTING_RULES=code_gen:code,review:main,test_gen:code,chat:main
MODEL_ROUTING_FALLBACK=true
